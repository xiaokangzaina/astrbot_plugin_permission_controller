{
  "screenshot_settings": {
    "description": "默认截图参数",
    "hint": "这些是默认截图参数。前端页面中单个群聊填写的截图参数会优先覆盖这里。",
    "type": "object",
    "items": {
      "default_viewport_width": {
        "description": "默认浏览器窗口宽度",
        "type": "int",
        "default": 1280
      },
      "default_viewport_height": {
        "description": "默认浏览器窗口高度",
        "type": "int",
        "default": 720
      },
      "default_wait_seconds": {
        "description": "默认页面等待秒数",
        "hint": "网页加载慢就调大。",
        "type": "float",
        "default": 5
      }
    }
  },
  "advanced_settings": {
    "description": "高级设置",
    "hint": "一般无需修改。",
    "type": "object",
    "items": {
      "platform": {
        "description": "平台实例 ID",
        "hint": "留空自动匹配。AstrBot v4 通常不是 aiocqhttp，而是 cmd_config.json 里的平台 id，例如 default。",
        "type": "string",
        "default": ""
      },
      "platform_type": {
        "description": "平台类型",
        "hint": "自动匹配平台实例时使用。QQ/NapCat/OneBot 一般保持 aiocqhttp。",
        "type": "string",
        "options": [
          "aiocqhttp"
        ],
        "default": "aiocqhttp"
      }
    }
  }
}
